{
  "name": "tree-sitter-ferron",
  "version": "0.1.0",
  "description": "Ferron grammar for tree-sitter",
  "type": "module",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "ferron"
  ],
  "license": "MIT",
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "XDG_CACHE_HOME=/tmp/tree-sitter-cache tree-sitter test --config-path .tree-sitter-config.json",
    "parse:examples": "XDG_CACHE_HOME=/tmp/tree-sitter-cache tree-sitter parse --config-path .tree-sitter-config.json ../ferron/examples/simple/src/simple.fer ../ferron/examples/logstats/main.fer"
  },
  "tree-sitter": [
    {
      "scope": "source.ferron",
      "file-types": [
        "fer"
      ]
    }
  ]
}
